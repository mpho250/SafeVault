
using Microsoft.AspNetCore.Authentication;
using Microsoft.AspNetCore.Authentication.Cookies;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Antiforgery;
using Microsoft.Data.Sqlite;
using System.Security.Claims;
using System.Text.Encodings.Web;
using System.Text.RegularExpressions;

var builder = WebApplication.CreateBuilder(args);

const string connectionString = "Data Source=safevault.db";

// Register security services
builder.Services.AddSingleton<IPasswordHasher<AppUser>, PasswordHasher<AppUser>>();
builder.Services.AddAntiforgery(options =>
{
    options.HeaderName = "X-CSRF-TOKEN";
});

builder.Services.AddAuthentication(
    CookieAuthenticationDefaults.AuthenticationScheme)
    .AddCookie(options =>
    {
        options.LoginPath = "/login";
        options.Cookie.Name = "SafeVault.Auth";
        options.Cookie.HttpOnly = true;
        options.Cookie.SecurePolicy = CookieSecurePolicy.Always;
        options.Cookie.SameSite = SameSiteMode.Strict;
        options.SlidingExpiration = true;
        options.ExpireTimeSpan = TimeSpan.FromMinutes(30);
    });

builder.Services.AddAuthorization();

var app = builder.Build();

app.UseHttpsRedirection();
app.UseAuthentication();
app.UseAuthorization();

// Create the database and Users table
await using (var connection = new SqliteConnection(connectionString))
{
    await connection.OpenAsync();

    var command = connection.CreateCommand();

    command.CommandText = """
        CREATE TABLE IF NOT EXISTS Users (
            Id INTEGER PRIMARY KEY AUTOINCREMENT,
            Email TEXT NOT NULL UNIQUE,
            PasswordHash TEXT NOT NULL,
            Role TEXT NOT NULL
        );
        """;

    await command.ExecuteNonQueryAsync();
}

// Create an administrator only when environment credentials are supplied.
// Never put administrator credentials directly in this source code.
var adminEmail = Environment.GetEnvironmentVariable("SAFEVAULT_ADMIN_EMAIL");
var adminPassword = Environment.GetEnvironmentVariable("SAFEVAULT_ADMIN_PASSWORD");

if (!string.IsNullOrWhiteSpace(adminEmail) &&
    !string.IsNullOrWhiteSpace(adminPassword))
{
    var hasher = app.Services.GetRequiredService<IPasswordHasher<AppUser>>();

    var admin = new AppUser
    {
        Email = adminEmail.Trim().ToLowerInvariant(),
        Role = "Admin"
    };

    admin.PasswordHash = hasher.HashPassword(admin, adminPassword);

    await using var db = new SqliteConnection(connectionString);
    await db.OpenAsync();

    var cmd = db.CreateCommand();
    cmd.CommandText = """
        INSERT OR IGNORE INTO Users (Email, PasswordHash, Role)
        VALUES ($email, $hash, $role);
        """;

    cmd.Parameters.AddWithValue("$email", admin.Email);
    cmd.Parameters.AddWithValue("$hash", admin.PasswordHash);
    cmd.Parameters.AddWithValue("$role", admin.Role);

    await cmd.ExecuteNonQueryAsync();
}

// Obtain an anti-forgery token before making POST requests.
app.MapGet("/antiforgery", (IAntiforgery antiforgery, HttpContext context) =>
{
    var tokens = antiforgery.GetAndStoreTokens(context);

    return Results.Ok(new
    {
        Token = tokens.RequestToken
    });
});

// User registration
app.MapPost("/register", async (
    RegisterRequest request,
    IPasswordHasher<AppUser> hasher,
    IAntiforgery antiforgery,
    HttpContext context) =>
{
    try
    {
        await antiforgery.ValidateRequestAsync(context);
    }
    catch (AntiforgeryValidationException)
    {
        return Results.BadRequest("Invalid anti-forgery token.");
    }

    if (string.IsNullOrWhiteSpace(request.Email) ||
        request.Email.Length > 254 ||
        !Regex.IsMatch(request.Email,
            @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
    {
        return Results.BadRequest("Invalid email address.");
    }

    if (string.IsNullOrWhiteSpace(request.Password) ||
        request.Password.Length < 12 ||
        request.Password.Length > 128)
    {
        return Results.BadRequest(
            "Password must contain between 12 and 128 characters.");
    }

    var user = new AppUser
    {
        Email = request.Email.Trim().ToLowerInvariant(),
        Role = "User"
    };

    user.PasswordHash = hasher.HashPassword(user, request.Password);

    try
    {
        await using var db = new SqliteConnection(connectionString);
        await db.OpenAsync();

        var cmd = db.CreateCommand();

        cmd.CommandText = """
            INSERT INTO Users (Email, PasswordHash, Role)
            VALUES ($email, $hash, $role);
            """;

        cmd.Parameters.AddWithValue("$email", user.Email);
        cmd.Parameters.AddWithValue("$hash", user.PasswordHash);
        cmd.Parameters.AddWithValue("$role", user.Role);

        await cmd.ExecuteNonQueryAsync();

        return Results.Ok("Registration successful.");
    }
    catch (SqliteException)
    {
        return Results.BadRequest(
            "Registration could not be completed.");
    }
});

// User login
app.MapPost("/login", async (
    LoginRequest request,
    IPasswordHasher<AppUser> hasher,
    IAntiforgery antiforgery,
    HttpContext context) =>
{
    try
    {
        await antiforgery.ValidateRequestAsync(context);
    }
    catch (AntiforgeryValidationException)
    {
        return Results.BadRequest("Invalid anti-forgery token.");
    }

    if (string.IsNullOrWhiteSpace(request.Email) ||
        string.IsNullOrWhiteSpace(request.Password))
    {
        return Results.BadRequest("Email and password are required.");
    }

    await using var db = new SqliteConnection(connectionString);
    await db.OpenAsync();

    var cmd = db.CreateCommand();

    cmd.CommandText = """
        SELECT Id, Email, PasswordHash, Role
        FROM Users
        WHERE Email = $email;
        """;

    cmd.Parameters.AddWithValue(
        "$email",
        request.Email.Trim().ToLowerInvariant());

    await using var reader = await cmd.ExecuteReaderAsync();

    if (!await reader.ReadAsync())
    {
        return Results.Unauthorized();
    }

    var user = new AppUser
    {
        Id = reader.GetInt32(0),
        Email = reader.GetString(1),
        PasswordHash = reader.GetString(2),
        Role = reader.GetString(3)
    };

    var result = hasher.VerifyHashedPassword(
        user,
        user.PasswordHash,
        request.Password);

    if (result == PasswordVerificationResult.Failed)
    {
        return Results.Unauthorized();
    }

    var claims = new List<Claim>
    {
        new(ClaimTypes.NameIdentifier, user.Id.ToString()),
        new(ClaimTypes.Name, user.Email),
        new(ClaimTypes.Role, user.Role)
    };

    var identity = new ClaimsIdentity(
        claims,
        CookieAuthenticationDefaults.AuthenticationScheme);

    var principal = new ClaimsPrincipal(identity);

    await context.SignInAsync(
        CookieAuthenticationDefaults.AuthenticationScheme,
        principal);

    return Results.Ok("Login successful.");
});

// User logout
app.MapPost("/logout", async (
    HttpContext context,
    IAntiforgery antiforgery) =>
{
    try
    {
        await antiforgery.ValidateRequestAsync(context);
    }
    catch (AntiforgeryValidationException)
    {
        return Results.BadRequest("Invalid anti-forgery token.");
    }

    await context.SignOutAsync(
        CookieAuthenticationDefaults.AuthenticationScheme);

    return Results.Ok("Logged out successfully.");
}).RequireAuthorization();

// Protected user profile
app.MapGet("/profile", (HttpContext context) =>
{
    return Results.Ok(new
    {
        Email = context.User.Identity?.Name,
        Role = context.User.FindFirst(ClaimTypes.Role)?.Value
    });
}).RequireAuthorization();

// Administrator-only endpoint
app.MapGet("/admin", () =>
{
    return Results.Ok("Welcome, administrator.");
}).RequireAuthorization(policy =>
    policy.RequireRole("Admin"));

// XSS protection through HTML encoding
app.MapGet("/safe-output", (string input) =>
{
    if (input.Length > 1000)
    {
        return Results.BadRequest("Input is too long.");
    }

    var safeContent = HtmlEncoder.Default.Encode(input);

    return Results.Ok(new
    {
        SafeContent = safeContent
    });
});

app.Run();

// User model
public class AppUser
{
    public int Id { get; set; }

    public string Email { get; set; } = "";

    public string PasswordHash { get; set; } = "";

    public string Role { get; set; } = "User";
}

// Request models
public record RegisterRequest(string? Email, string? Password);

public record LoginRequest(string? Email, string? Password);
